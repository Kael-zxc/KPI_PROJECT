# C:\KPI_PROJECT\Dockerfile.backend
FROM python:3.11-slim

WORKDIR /app

# Копируем .env (если нужно внутри контейнера)
COPY .env ./

# Копируем файл зависимостей
COPY backend/requirements.txt ./requirements.txt

# Устанавливаем зависимости, включая gunicorn
RUN pip install --upgrade pip \
 && pip install --no-cache-dir -r requirements.txt

# Копируем всё ваше приложение
COPY backend/ ./backend/

# Ставим рабочую директорию на папку с manage.py
WORKDIR /app/backend

# По-умолчанию запускаем gunicorn
CMD ["gunicorn", "kpi_project.wsgi:application", "--bind", "0.0.0.0:8000"]

